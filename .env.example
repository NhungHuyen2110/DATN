# Isolated staging values only. Existing local docker-compose.yml remains usable.
POSTGRES_DB=lumiere_db
POSTGRES_USER=lumiere_user
POSTGRES_PASSWORD=replace-with-staging-secret
NEO4J_PASSWORD=replace-with-staging-secret
GRAFANA_PASSWORD=replace-with-staging-secret
STAGING_ORIGIN=http://localhost:8080
# Provision a read-only role on the staging catalog; URL-encode special characters.
AI_DATABASE_URL=postgresql://ai_catalog_reader:replace-with-staging-secret@postgres:5432/lumiere_db
AI_PIPELINE=legacy
# Keep false unless an operator has explicitly authorized downloading model files.
AI_ALLOW_MODEL_DOWNLOAD=false
AI_CATALOG_SOURCE=csv
QDRANT_COLLECTION=lumiere_products_v2
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
