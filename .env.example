# Synthetic isolated test values ONLY. Pass this file explicitly to Compose.
POSTGRES_DB=lumiere_test_rebuild
POSTGRES_USER=lumiere_test
POSTGRES_PASSWORD=test-only-change-before-hosting
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_POOL_TIMEOUT_SECONDS=3
NEO4J_PASSWORD=test-only-change-before-hosting
PUBLIC_PORT=18080
# Read-only model cache on D; no download from a request.
MODEL_CACHE_PATH=./.local-tmp/models
LUMIERE_METRICS_TOKEN=test-only-local-scrape-token
GRAFANA_ADMIN_PASSWORD=test-only-change-before-hosting
LUMIERE_AI_DIAGNOSTICS_TOKEN=test-only-local-diagnostics-token
# Multi-source AI only; connect budget stays 3 s and read budget is bounded 3..40.
LUMIERE_AI_DIAGNOSTICS_TIMEOUT_SECONDS=30
# Model/revision/collection must stay aligned; this name was derived by index_identity.
QDRANT_COLLECTION=jewelry_products_v_c0efd814ee4f
EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
# Enable consistently in Business/AI/worker only after schema 0010 and acceptance.
LUMIERE_ATTRIBUTE_REVIEWS_ENABLED=false
